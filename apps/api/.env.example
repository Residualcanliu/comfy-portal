# ComfyPortal API 环境变量（复制为 .env 使用）
DATABASE_URL=postgresql+psycopg://comfy:comfy@127.0.0.1:5432/comfyportal
REDIS_URL=redis://:PASSWORD@127.0.0.1:6379/0
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me
DAILY_QUOTA_DEFAULT=20
ARTIFACTS_DIR=./data/artifacts   # Docker 部署时改为 /data/artifacts

# 本地开发：打开文档、放行本地前端、关闭只读模式
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
READONLY_DEMO=false
