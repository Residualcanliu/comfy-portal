# ComfyPortal worker 环境变量（复制为 .env 使用）
REDIS_URL=redis://:PASSWORD@TAILNET_IP:6379/0   # M1 本地 dev 用 redis://127.0.0.1:6379/0
COMFYUI_URL=http://127.0.0.1:8188
API_INTERNAL_URL=http://127.0.0.1:8000          # M1 本地 dev；生产 http://TAILNET_IP:8001
INTERNAL_TOKEN=change-me
METRICS_PORT=9101
# metrics 监听地址，默认 127.0.0.1（只本机可读）。
# 要让 VPS 上的 Prometheus 跨机抓取（deploy/prometheus.yml 抓 __WORKER_IP__:9101），
# 把这台主机的 tailnet IP 填进来。
METRICS_ADDR=127.0.0.1
