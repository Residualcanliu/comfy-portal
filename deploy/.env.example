# ComfyPortal 部署环境变量（复制为 .env 使用；真实密钥绝不提交）
# 组网信息（复制后填真实 tailnet IP）：
#   本地 worker tailnet IP = <worker-tailnet-ip>   → prometheus.yml 里 __WORKER_IP__ 替换成它
#   VPS     tailnet IP = <vps-tailnet-ip>     → 下面的 TAILNET_IP

TAILNET_IP=<vps-tailnet-ip>

# Redis（requirepass）
REDIS_PASSWORD=change-me

# Postgres
POSTGRES_USER=comfy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=comfyportal

# API 认证
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me
DAILY_QUOTA_DEFAULT=20

# Cloudflare Tunnel（cf-tunnel.md 步骤里拿到的 token）
CF_TUNNEL_TOKEN=change-me
