# ComfyPortal 部署环境变量（复制为 .env 使用；真实密钥绝不提交）
# 组网信息（复制后填真实 tailnet IP）：
#   本地 worker tailnet IP = <worker-tailnet-ip>   → prometheus.yml 里 __WORKER_IP__ 替换成它
#   VPS     tailnet IP = <vps-tailnet-ip>     → 下面的 TAILNET_IP

TAILNET_IP=<vps-tailnet-ip>

# 内部接口的源 IP 闸门（CIDR）。默认取 Tailscale 网段。
# 除调试外不要改成 0.0.0.0/0 —— 那等于关掉这道闸门。
TAILNET_CIDR=100.64.0.0/10

# Redis（requirepass）
REDIS_PASSWORD=change-me

# Postgres
POSTGRES_USER=comfy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=comfyportal

# API 认证
# JWT_SECRET / INTERNAL_TOKEN 必须是随机长串，不能留 change-me：
# 本仓库公开，示例值等于公开的密钥。
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me
DAILY_QUOTA_DEFAULT=20

# 只读演示模式：true 时服务端拒绝注册与生成，公开站点仅展示已有内容。
# 合规用途：让公众无法通过本站获得生成能力。
READONLY_DEMO=true

# 生产必须关闭 API 文档，避免 /docs 与 /openapi.json 暴露全部路由。
DOCS_ENABLED=false

# 前端域名白名单（逗号分隔），不要用 *。留空则拒绝所有跨域请求。
CORS_ORIGINS=https://your-app.vercel.app

# Grafana 管理员口令（不设则用 admin/admin）
GRAFANA_ADMIN_PASSWORD=change-me

# Cloudflare Tunnel（cf-tunnel.md 步骤里拿到的 token）
CF_TUNNEL_TOKEN=change-me
